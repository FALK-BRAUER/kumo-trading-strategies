# Secrets NEVER live in this tree. They are injected from a secret store at deploy time. If a file
# below ever appears, something is wrong — fix the deploy, do not add an exception.
.env
.env.*
*.env.local
*secret*
*credential*
*.pem
*.key

# The exception is STRUCTURAL, not enumerated: `bin/` holds executable code by definition, and a
# secret appearing there would itself be the incident. A manifest is a declaration
# (`ENV_VAR=secret-store-name`), never a value; its shape is pinned by a test.
!bin/**
!instances/*/secrets.manifest

# Generated bytecode and environments
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# Node
node_modules/
.next/
out/

# Local state that is evidence, not content
logs/
.stage/
.backups/
*.log

# Operating record — private by construction, never in the public tree
zz_handoffs/
FOR_*.md
RUNBOOK.md

# Editors / OS
.DS_Store
.idea/
.vscode/

# Backtest data lives IN each set (`kumo_strategies/strategies/<name>/backtests/<set>/`, parquet
# through Git LFS) and is tracked on purpose — the set IS the data. Nothing else data-shaped belongs here.
data/
artifacts/
*.log

# Nothing data-shaped is tracked outside a backtest set or a tests/…/fixtures/ folder. `research/`
# and `data/` do not exist in this tree; the patterns stay so a file dropped there is refused by git
# before the suite refuses it (tests/public/test_no_tracked_data_files.py).
research/**/*.csv
research/**/*.parquet
research/**/*.pkl
research/**/*.npz
research/**/*.h5
research/**/*.feather
research/**/*.json
data/**/*.csv
data/**/*.parquet
data/**/*.pkl
data/**/*.npz
data/**/*.h5
data/**/*.feather
